# Tienda Hispana El Rey — configuración local
# Copia este archivo como .env y completa los valores. Nunca confirmes .env.

DB_HOST=localhost
DB_NAME=tienda_el_rey
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Para PostgreSQL administrado, usa una URL completa:
# DATABASE_URL=postgresql://usuario:contraseña@servidor:5432/base?sslmode=require

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GLOBAL_TAX_RATE=8.25

APP_NAME=Tienda Hispana El Rey
APP_URL=http://localhost:8080
SESSION_SECRET=
MAX_UPLOAD_SIZE=10485760
SESSION_LIFETIME=86400

# One-time administrator bootstrap. Set these only while running
# `php scripts/bootstrap-admin.php`, then remove the password from the environment.
ADMIN_BOOTSTRAP_NAME=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
